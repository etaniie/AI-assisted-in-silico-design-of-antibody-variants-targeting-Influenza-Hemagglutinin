   "source": [
    "# Part 3: CDR Region Mapping\n",
    "\n",
    "## Objective\n",
    "Identify and map Complementarity-Determining Regions (CDRs) in the 5XKU antibody structure to prepare for AI-guided mutation design.\n",
    "\n",
    "## Focus Structure: 5XKU\n",
    "- **Chain A, B**: H7N9 Hemagglutinin (antigen)\n",
    "- **Chain C**: Antibody chain (HNIgGA6)\n",
    "\n",
    "## CDR Identification Strategy\n",
    "1. **Sequence-based CDR prediction** using Kabat numbering\n",
    "2. **Structure-based interface analysis** from Part 2\n",
    "3. **PyMOL visualization** of CDR regions\n",
    "4. **Hotspot identification** for mutation targeting\n",
    "\n",
    "## Expected CDR Regions\n",
    "- **CDR1**: ~24-34 (varies by numbering scheme)\n",
    "- **CDR2**: ~50-65 \n",
    "- **CDR3**: ~95-102 (most variable, key for specificity)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import os\n",
    "import sys\n",
    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# Structural biology\n",
    "from Bio.PDB import PDBParser, PDBIO, NeighborSearch\n",
    "from Bio.SeqUtils import seq1\n",
    "from Bio.Seq import Seq\n",
    "from Bio.SeqRecord import SeqRecord\n",
    "\n",
    "# Visualization\n",
    "import py3Dmol\n",
    "from IPython.display import Image, display\n",
    "\n",
    "# Set up plotting\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"🧬 CDR Mapping Pipeline - Part 3\")\n",
    "print(\"Dependencies loaded successfully!\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load 5XKU Structure and Interface Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Load cleaned 5XKU structure from Part 2\n",
    "structure_file = Path('../part2_structure_preprocessing/5XKU_clean.pdb')\n",
    "interface_file = Path('../part2_structure_preprocessing/5XKU_interface_data.json')\n",
    "\n",
    "print(f\"📁 Loading structure: {structure_file}\")\n",
    "print(f\"📁 Loading interface data: {interface_file}\")\n",
    "\n",
    "if not structure_file.exists():\n",
    "    print(\"❌ 5XKU_clean.pdb not found in part2 directory!\")\n",
    "    print(\"Run Part 2 preprocessing first.\")\n",
    "    sys.exit()\n",
    "\n",
    "# Parse structure\n",
    "parser = PDBParser(QUIET=True)\n",
    "structure_5xku = parser.get_structure('5XKU', str(structure_file))\n",
    "\n",
    "# Load interface data if available\n",
    "interface_data = {}\n",
    "if interface_file.exists():\n",
    "    with open(interface_file, 'r') as f:\n",
    "        interface_data = json.load(f)\n",
    "    print(\"✅ Interface data loaded\")\n",
    "else:\n",
    "    print(\"⚠️ Interface data not found - will calculate fresh\")\n",
    "\n",
    "print(f\"✅ Structure loaded successfully\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Extract Antibody Chain Sequence"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def extract_chain_sequence(structure, chain_id):\n",
    "    \"\"\"Extract amino acid sequence from PDB chain\"\"\"\n",
    "    \n",
    "    model = structure[0]\n",
    "    chain = model[chain_id]\n",
    "    \n",
    "    sequence_data = {\n",
    "        'chain_id': chain_id,\n",
    "        'residues': [],\n",
    "        'sequence': '',\n",
    "        'residue_numbers': [],\n",
    "        'missing_residues': []\n",
    "    }\n",
    "    \n",
    "    prev_resnum = None\n",
    "    \n",
    "    for residue in chain:\n",
    "        if residue.id[0] == ' ':  # Standard residue\n",
    "            resnum = residue.id[1]\n",
    "            resname = residue.resname\n",
    "            \n",
    "            # Check for gaps\n",
    "            if prev_resnum and resnum - prev_resnum > 1:\n",
    "                for missing_num in range(prev_resnum + 1, resnum):\n",
    "                    sequence_data['missing_residues'].append(missing_num)\n",
    "            \n",
    "            # Convert to single letter\n",
    "            try:\n",
    "                single_letter = seq1(resname)\n",
    "            except:\n",
    "                single_letter = 'X'\n",
    "            \n",
    "            sequence_data['residues'].append({\n",
    "                'number': resnum,\n",
    "                'name': resname,\n",
    "                'single': single_letter\n",
    "            })\n",
    "            \n",
    "            sequence_data['sequence'] += single_letter\n",
    "            sequence_data['residue_numbers'].append(resnum)\n",
    "            \n",
    "            prev_resnum = resnum\n",
    "    \n",
    "    return sequence_data\n",
    "\n",
    "# Extract antibody chain sequence (Chain C)\n",
    "antibody_data = extract_chain_sequence(structure_5xku, 'C')\n",
    "\n",
    "print(f\"🧬 Antibody Chain C Analysis:\")\n",
    "print(f\"   Total residues: {len(antibody_data['residues'])}\")\n",
    "print(f\"   Residue range: {min(antibody_data['residue_numbers'])}-{max(antibody_data['residue_numbers'])}\")\n",
    "print(f\"   Missing residues: {len(antibody_data['missing_residues'])}\")\n",
    "if antibody_data['missing_residues']:\n",
    "    print(f\"   Gaps at: {antibody_data['missing_residues'][:10]}{'...' if len(antibody_data['missing_residues']) > 10 else ''}\")\n",
    "\n",
    "print(f\"\\n📝 Sequence (first 50 residues):\")\n",
    "print(f\"   {antibody_data['sequence'][:50]}...\")\n",
    "\n",
    "# Save sequence data\n",
    "os.makedirs('sequences', exist_ok=True)\n",
    "with open('sequences/5XKU_chain_C_sequence.json', 'w') as f:\n",
    "    json.dump(antibody_data, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 Sequence data saved to: sequences/5XKU_chain_C_sequence.json\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. CDR Region Prediction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def predict_cdr_regions_kabat(sequence_data, chain_type='heavy'):\n",
    "    \"\"\"Predict CDR regions using Kabat numbering scheme\"\"\"\n",
    "    \n",
    "    residue_numbers = sequence_data['residue_numbers']\n",
    "    sequence = sequence_data['sequence']\n",
    "    \n",
    "    # Kabat numbering CDR definitions (approximate)\n",
    "    if chain_type.lower() == 'heavy':\n",
    "        cdr_definitions = {\n",
    "            'CDR1': (31, 35),\n",
    "            'CDR2': (50, 65), \n",
    "            'CDR3': (95, 102)\n",
    "        }\n",
    "    else:  # light chain\n",
    "        cdr_definitions = {\n",
    "            'CDR1': (24, 34),\n",
    "            'CDR2': (50, 56),\n",
    "            'CDR3': (89, 97)\n",
    "        }\n",
    "    \n",
    "    predicted_cdrs = {}\n",
    "    \n",
    "    for cdr_name, (start, end) in cdr_definitions.items():\n",
    "        # Find residues in CDR range\n",
    "        cdr_residues = []\n",
    "        cdr_sequence = ''\n",
    "        \n",
    "        for i, resnum in enumerate(residue_numbers):\n",
    "            if start <= resnum <= end:\n",
    "                cdr_residues.append({\n",
    "                    'number': resnum,\n",
    "                    'amino_acid': sequence[i] if i < len(sequence) else 'X',\n",
    "                    'index': i\n",
    "                })\n",
    "                cdr_sequence += sequence[i] if i < len(sequence) else 'X'\n",
    "        \n",
    "        predicted_cdrs[cdr_name] = {\n",
    "            'definition_range': (start, end),\n",
    "            'found_residues': cdr_residues,\n",
    "            'sequence': cdr_sequence,\n",
    "            'length': len(cdr_residues),\n",
    "            'actual_range': (cdr_residues[0]['number'], cdr_residues[-1]['number']) if cdr_residues else None\n",
    "        }\n",
    "    \n",
    "    return predicted_cdrs\n",
    "\n",
    "def analyze_sequence_for_chain_type(sequence):\n",
    "    \"\"\"Attempt to determine if sequence is heavy or light chain\"\"\"\n",
    "    \n",
    "    # Simple heuristics:\n",
    "    # Heavy chains are typically longer (>400 residues)\n",
    "    # Light chains are typically shorter (~200-220 residues)\n",
    "    \n",
    "    length = len(sequence)\n",
    "    \n",
    "    if length > 300:\n",
    "        return 'heavy'\n",
    "    elif length < 250:\n",
    "        return 'light'\n",
    "    else:\n",
    "        return 'unknown'\n",
    "\n",
    "# Determine chain type\n",
    "chain_type = analyze_sequence_for_chain_type(antibody_data['sequence'])\n",
    "print(f\"🔍 Chain Type Prediction: {chain_type.upper()}\")\n",
    "print(f\"   Based on sequence length: {len(antibody_data['sequence'])} residues\")\n",
    "\n",
    "# Predict CDRs for both heavy and light (since we're not 100% sure)\n",
    "print(f\"\\n🎯 CDR Predictions:\")\n",
    "\n",
    "for test_type in ['heavy', 'light']:\n",
    "    cdrs = predict_cdr_regions_kabat(antibody_data, test_type)\n",
    "    \n",
    "    print(f\"\\n   As {test_type.upper()} chain:\")\n",
    "    for cdr_name, cdr_info in cdrs.items():\n",
    "        if cdr_info['found_residues']:\n",
    "            print(f\"     {cdr_name}: residues {cdr_info['actual_range'][0]}-{cdr_info['actual_range'][1]} ({cdr_info['length']} aa)\")\n",
    "            print(f\"              Sequence: {cdr_info['sequence']}\")\n",
    "        else:\n",
    "            print(f\"     {cdr_name}: NOT FOUND in defined range {cdr_info['definition_range']}\")\n",
    "\n",
    "# Use the most likely chain type for further analysis\n",
    "if chain_type == 'unknown':\n",
    "    chain_type = 'heavy'  # Default assumption\n",
    "    print(f\"\\n⚠️ Uncertain chain type, assuming HEAVY chain\")\n",
    "\n",
    "final_cdrs = predict_cdr_regions_kabat(antibody_data, chain_type)\n",
    "\n",
    "# Save CDR predictions\n",
    "cdr_data = {\n",
    "    'chain_type': chain_type,\n",
    "    'cdrs': final_cdrs,\n",
    "    'sequence_length': len(antibody_data['sequence']),\n",
    "    'total_cdr_residues': sum([cdr['length'] for cdr in final_cdrs.values()])\n",
    "}\n",
    "\n",
    "with open('sequences/5XKU_CDR_predictions.json', 'w') as f:\n",
    "    json.dump(cdr_data, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 CDR predictions saved to: sequences/5XKU_CDR_predictions.json\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Interface vs CDR Overlap Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def calculate_interface_residues(structure, antibody_chain='C', antigen_chains=['A', 'B'], cutoff=5.0):\n",
    "    \"\"\"Calculate antibody-antigen interface residues\"\"\"\n",
    "    \n",
    "    model = structure[0]\n",
    "    \n",
    "    # Get antibody atoms\n",
    "    antibody_atoms = []\n",
    "    for residue in model[antibody_chain]:\n",
    "        if residue.id[0] == ' ':\n",
    "            for atom in residue:\n",
    "                antibody_atoms.append(atom)\n",
    "    \n",
    "    # Get antigen atoms\n",
    "    antigen_atoms = []\n",
    "    for chain_id in antigen_chains:\n",
    "        for residue in model[chain_id]:\n",
    "            if residue.id[0] == ' ':\n",
    "                for atom in residue:\n",
    "                    antigen_atoms.append(atom)\n",
    "    \n",
    "    # Find neighbors\n",
    "    ns = NeighborSearch(antigen_atoms)\n",
    "    interface_residues = set()\n",
    "    \n",
    "    for atom in antibody_atoms:\n",
    "        neighbors = ns.search(atom.coord, cutoff)\n",
    "        if neighbors:\n",
    "            interface_residues.add(atom.parent.id[1])\n",
    "    \n",
    "    return sorted(list(interface_residues))\n",
    "\n",
    "# Calculate interface residues\n",
    "interface_residues = calculate_interface_residues(structure_5xku)\n",
    "\n",
    "print(f\"🔗 Interface Analysis (5Å cutoff):\")\n",
    "print(f\"   Antibody residues near antigen: {len(interface_residues)}\")\n",
    "print(f\"   Interface residues: {interface_residues[:15]}{'...' if len(interface_residues) > 15 else ''}\")\n",
    "\n",
    "# Analyze CDR-Interface overlap\n",
    "print(f\"\\n🎯 CDR-Interface Overlap Analysis:\")\n",
    "\n",
    "cdr_interface_overlap = {}\n",
    "total_cdr_interface = 0\n",
    "\n",
    "for cdr_name, cdr_info in final_cdrs.items():\n",
    "    cdr_residue_numbers = [res['number'] for res in cdr_info['found_residues']]\n",
    "    overlap = set(cdr_residue_numbers).intersection(set(interface_residues))\n",
    "    \n",
    "    overlap_percentage = (len(overlap) / len(cdr_residue_numbers) * 100) if cdr_residue_numbers else 0\n",
    "    \n",
    "    cdr_interface_overlap[cdr_name] = {\n",
    "        'cdr_residues': cdr_residue_numbers,\n",
    "        'interface_residues': sorted(list(overlap)),\n",
    "        'overlap_count': len(overlap),\n",
    "        'total_cdr_residues': len(cdr_residue_numbers),\n",
    "        'overlap_percentage': overlap_percentage\n",
    "    }\n",
    "    \n",
    "    total_cdr_interface += len(overlap)\n",
    "    \n",
    "    print(f\"\\n   {cdr_name}:\")\n",
    "    print(f\"     CDR residues: {cdr_residue_numbers}\")\n",
    "    print(f\"     Interface residues: {sorted(list(overlap))}\")\n",
    "    print(f\"     Overlap: {len(overlap)}/{len(cdr_residue_numbers)} ({overlap_percentage:.1f}%)\")\n",
    "\n",
    "print(f\"\\n📊 Summary:\")\n",
    "print(f\"   Total CDR residues at interface: {total_cdr_interface}\")\n",
    "print(f\"   Total interface residues: {len(interface_residues)}\")\n",
    "print(f\"   CDR contribution to interface: {total_cdr_interface/len(interface_residues)*100:.1f}%\")\n",
    "\n",
    "# Save overlap analysis\n",
    "overlap_data = {\n",
    "    'interface_residues': interface_residues,\n",
    "    'cdr_interface_overlap': cdr_interface_overlap,\n",
    "    'summary': {\n",
    "        'total_cdr_interface': total_cdr_interface,\n",
    "        'total_interface': len(interface_residues),\n",
    "        'cdr_interface_percentage': total_cdr_interface/len(interface_residues)*100\n",
    "    }\n",
    "}\n",
    "\n",
    "with open('analysis/CDR_interface_overlap.json', 'w') as f:\n",
    "    os.makedirs('analysis', exist_ok=True)\n",
    "    json.dump(overlap_data, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 Overlap analysis saved to: analysis/CDR_interface_overlap.json\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
