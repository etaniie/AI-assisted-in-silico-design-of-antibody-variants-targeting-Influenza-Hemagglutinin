   "source": [
    "## 5. Mutation Hotspot Identification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def identify_mutation_hotspots(cdr_data, interface_overlap, priority_weights=None):\n",
    "    \"\"\"Identify high-priority residues for mutation\"\"\"\n",
    "    \n",
    "    if priority_weights is None:\n",
    "        priority_weights = {\n",
    "            'CDR3': 3.0,  # Highest priority - most variable\n",
    "            'CDR1': 2.0,  # Medium priority\n",
    "            'CDR2': 2.0,  # Medium priority\n",
    "            'interface': 2.5,  # High priority - direct binding\n",
    "            'length_bonus': 0.5  # Bonus for longer CDRs\n",
    "        }\n",
    "    \n",
    "    hotspots = []\n",
    "    \n",
    "    for cdr_name, overlap_info in interface_overlap.items():\n",
    "        cdr_weight = priority_weights.get(cdr_name, 1.0)\n",
    "        interface_weight = priority_weights.get('interface', 1.0)\n",
    "        \n",
    "        # Score each residue in this CDR\n",
    "        for residue_num in overlap_info['cdr_residues']:\n",
    "            score = cdr_weight\n",
    "            \n",
    "            # Bonus if at interface\n",
    "            if residue_num in overlap_info['interface_residues']:\n",
    "                score += interface_weight\n",
    "            \n",
    "            # Length bonus for longer CDRs\n",
    "            if overlap_info['total_cdr_residues'] > 8:\n",
    "                score += priority_weights.get('length_bonus', 0.0)\n",
    "            \n",
    "            # Find amino acid for this residue\n",
    "            amino_acid = 'X'\n",
    "            for res_data in cdr_data['cdrs'][cdr_name]['found_residues']:\n",
    "                if res_data['number'] == residue_num:\n",
    "                    amino_acid = res_data['amino_acid']\n",
    "                    break\n",
    "            \n",
    "            hotspots.append({\n",
    "                'residue_number': residue_num,\n",
    "                'amino_acid': amino_acid,\n",
    "                'cdr_region': cdr_name,\n",
    "                'at_interface': residue_num in overlap_info['interface_residues'],\n",
    "                'priority_score': score,\n",
    "                'mutation_rationale': f\"{cdr_name} residue\" + (\" at binding interface\" if residue_num in overlap_info['interface_residues'] else \"\")\n",
    "            })\n",
    "    \n",
    "    # Sort by priority score\n",
    "    hotspots.sort(key=lambda x: x['priority_score'], reverse=True)\n",
    "    \n",
    "    return hotspots\n",
    "\n",
    "# Identify mutation hotspots\n",
    "mutation_hotspots = identify_mutation_hotspots(cdr_data, cdr_interface_overlap)\n",
    "\n",
    "print(f\"🔥 Mutation Hotspot Analysis:\")\n",
    "print(f\"   Total candidate residues: {len(mutation_hotspots)}\")\n",
    "\n",
    "# Display top hotspots\n",
    "print(f\"\\n🎯 Top 10 Mutation Targets:\")\n",
    "print(f\"{'Rank':<4} {'Residue':<8} {'AA':<3} {'CDR':<5} {'Interface':<9} {'Score':<6} {'Rationale'}\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for i, hotspot in enumerate(mutation_hotspots[:10], 1):\n",
    "    interface_mark = \"YES\" if hotspot['at_interface'] else \"NO\"\n",
    "    print(f\"{i:<4} {hotspot['residue_number']:<8} {hotspot['amino_acid']:<3} {hotspot['cdr_region']:<5} {interface_mark:<9} {hotspot['priority_score']:<6.1f} {hotspot['mutation_rationale']}\")\n",
    "\n",
    "# Categorize by CDR\n",
    "print(f\"\\n📊 Hotspots by CDR Region:\")\n",
    "cdr_counts = {}\n",
    "for hotspot in mutation_hotspots:\n",
    "    cdr = hotspot['cdr_region']\n",
    "    cdr_counts[cdr] = cdr_counts.get(cdr, 0) + 1\n",
    "\n",
    "for cdr, count in cdr_counts.items():\n",
    "    interface_count = len([h for h in mutation_hotspots if h['cdr_region'] == cdr and h['at_interface']])\n",
    "    print(f\"   {cdr}: {count} total, {interface_count} at interface\")\n",
    "\n",
    "# Save hotspot analysis\n",
    "hotspot_data = {\n",
    "    'mutation_hotspots': mutation_hotspots,\n",
    "    'summary': {\n",
    "        'total_candidates': len(mutation_hotspots),\n",
    "        'interface_candidates': len([h for h in mutation_hotspots if h['at_interface']]),\n",
    "        'cdr_distribution': cdr_counts\n",
    "    },\n",
    "    'top_10_targets': mutation_hotspots[:10]\n",
    "}\n",
    "\n",
    "with open('analysis/mutation_hotspots.json', 'w') as f:\n",
    "    json.dump(hotspot_data, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 Hotspot analysis saved to: analysis/mutation_hotspots.json\")"
   ],
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. PyMOL Visualization Commands"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def generate_pymol_cdr_script(cdr_data, hotspots, filename='cdr_visualization.pml'):\n",
    "    \"\"\"Generate PyMOL script for CDR visualization\"\"\"\n",
    "    \n",
    "    script_lines = [\n",
    "        \"# PyMOL CDR Mapping Visualization Script\",\n",
    "        \"# Generated automatically from Part 3 analysis\\n\",\n",
    "        \"# Load structure\",\n",
    "        \"fetch 5XKU\",\n",
    "        \"remove solvent\", \n",
    "        \"remove hetatm\\n\",\n",
    "        \"# Basic visualization\",\n",
    "        \"hide everything\",\n",
    "        \"show cartoon\\n\",\n",
    "        \"# Color chains\",\n",
    "        \"color red, chain A      # HA chain A\",\n",
    "        \"color orange, chain B   # HA chain B\", \n",
    "        \"color gray80, chain C   # Antibody chain\\n\",\n",
    "        \"# Define CDR regions\"\n",
    "    ]\n",
    "    \n",
    "    cdr_colors = {'CDR1': 'blue', 'CDR2': 'green', 'CDR3': 'magenta'}\n",
    "    \n",
    "    for cdr_name, cdr_info in cdr_data['cdrs'].items():\n",
    "        if cdr_info['found_residues']:\n",
    "            residue_list = '+'.join([str(res['number']) for res in cdr_info['found_residues']])\n",
    "            color = cdr_colors.get(cdr_name, 'yellow')\n",
    "            \n",
    "            script_lines.extend([\n",
    "                f\"select {cdr_name}_region, chain C and resi {residue_list}\",\n",
    "                f\"color {color}, {cdr_name}_region\",\n",
    "                f\"show sticks, {cdr_name}_region\"\n",
    "            ])\n",
    "    \n",
    "    script_lines.extend([\n",
    "        \"\\n# Highlight top mutation hotspots\",\n",
    "        \"select top_hotspots, chain C and resi \" + '+'.join([str(h['residue_number']) for h in hotspots[:5]]),\n",
    "        \"color yellow, top_hotspots\",\n",
    "        \"show spheres, top_hotspots\",\n",
    "        \"\\n# Interface visualization\",\n",
    "        \"select interface, chain C within 5 of (chain A+B)\",\n",
    "        \"show sticks, interface\",\n",
    "        \"\\n# Create views\",\n",
    "        \"orient\",\n",
    "        \"zoom\",\n",
    "        \"\\n# Save images\",\n",
    "        \"png CDR_overview.png, width=1200, height=900, dpi=300, ray=1\",\n",
    "        \"\\n# Focus on CDRs\",\n",
    "        \"orient CDR1_region+CDR2_region+CDR3_region\",\n",
    "        \"zoom CDR1_region+CDR2_region+CDR3_region, 8\",\n",
    "        \"png CDR_closeup.png, width=1200, height=900, dpi=300, ray=1\",\n",
    "        \"\\n# Hotspot view\", \n",
    "        \"orient top_hotspots\",\n",
    "        \"zoom top_hotspots, 10\",\n",
    "        \"png mutation_hotspots.png, width=1200, height=900, dpi=300, ray=1\",\n",
    "        \"\\nprint 'CDR visualization complete!'\"\n",
    "    ]\n",
    "    \n",
    "    # Write script\n",
    "    os.makedirs('pymol_scripts', exist_ok=True)\n",
    "    script_path = f'pymol_scripts/{filename}'\n",
    "    \n",
    "    with open(script_path, 'w') as f:\n",
    "        f.write('\\n'.join(script_lines))\n",
    "    \n",
    "    return script_path\n",
    "\n",
    "# Generate PyMOL script\n",
    "pymol_script = generate_pymol_cdr_script(cdr_data, mutation_hotspots)\n",
    "\n",
    "print(f\"🎨 PyMOL Visualization Script Generated:\")\n",
    "print(f\"   Location: {pymol_script}\")\n",
    "print(f\"\\n📋 To run in PyMOL:\")\n",
    "print(f\"   1. Open PyMOL\")\n",
    "print(f\"   2. Run: @{pymol_script}\")\n",
    "print(f\"   3. Images will be saved as:\")\n",
    "print(f\"      - CDR_overview.png\")\n",
    "print(f\"      - CDR_closeup.png\")\n",
    "print(f\"      - mutation_hotspots.png\")\n",
    "\n",
    "# Display script contents\n",
    "print(f\"\\n📝 Script contents:\")\n",
    "with open(pymol_script, 'r') as f:\n",
    "    script_content = f.read()\n",
    "    print(f\"```\\n{script_content}\\n```\")"
   ],
